	(text "STMRocket (2025/12/09 by Edward S.)\n"
		(exclude_from_sim no)
		(at 86.868 21.59 0)
		(effects
			(font
				(size 4.064 4.064)
				(thickness 0.8128)
				(bold yes)
			)
		)
		(uuid "14ee7eaa-755f-4cc5-867c-0504ed9d38de")
	)
	(text "Project Description\n\nThis is a personal project for an STM32 flight computer that \nwill be flown on a model rocket to acheive the Level 1 high power \nrocketry certification. It is open source with details available \non the Github repository.\n\nhttps://github.com/esicoe/STMRocket\n\nCapabilities\n\nThe flight computer is able to log flight condition data, including \npressure, altitude, acceleration, gyroscope data and humidity. \nIt is powered by a 7.4V 2S LiPo battery, 3.3V from SWD, \nor through 5V USB type B.\n\nPurpose\n\nThe end goal is to use the computer to deploy a parachute through the \nPyro channel and successfully recover the rocket as well as the logged\ndata."
		(exclude_from_sim no)
		(at 202.692 49.022 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
			)
			(justify left)
		)
		(uuid "2b84fb72-e457-4a65-91a7-9970bdce83ae")
	)
	(text "About"
		(exclude_from_sim no)
		(at 211.328 23.368 0)
		(effects
